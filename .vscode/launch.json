{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ticket EDA",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/ticket_eda.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}/Code/eda_config.json"
      ]
    },
    {
      "name": "Match Soci 2026",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/members_ticket_match.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--members",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/Libro_soci_2025.csv",
        "--tickets",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/ListaTickets_31.12.25_10_50.csv",
        "--output-dir",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/match_2026_reports_31.12.25_10_50_updated_2"
      ]
    },
    {
      "name": "Ticket Phase Summary",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/ticket_phase_summary.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--early-phase0",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/ListaTicketVenduti_27Nov25.csv",
        "--phase1-other",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/Attendee_List_19.12.25_phase1+Chr+ambassPSYKY.csv",
        "--output",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/TicketsSummary/ticket_phase_summary.csv"
      ]
    },
    {
      "name": "Ticket Phase Summary (single file)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/ticket_phase_summary.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--single-file",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/ListaTickets_31.12.25_10_50.csv",
        "--output",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/TicketsSummary/ticket_phase_summary_31.12.25_10_50.csv"
      ]
    },
    {
      "name": "Merge Ticket Exports",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/tickets_merge.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--left",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/ListaTicketVenduti_27Nov25.csv",
        "--right",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/Attendee_List_19.12.25_phase1+Chr+ambassPSYKY.csv",
        "--output",
        "${workspaceFolder}/output/Libro_Soci_2025-2026/merged_19.12.25.csv"
      ]
    },
    {
      "name": "Ticket Paid Verified",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/tickets_paid_filter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--input",
        // "${workspaceFolder}/Documenti/Tickets/Lista_ticket_7chakras_2025_onlyGood.csv"
        "${workspaceFolder}/Documenti/Tickets/UntilPhase1_definitivo/UntilPhase1_definitivo.csv" ]
    },
    {
      "name": "CSV Flatten (generic)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/csv_flatten.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--input",
        "${workspaceFolder}/Documenti/Tickets/UntilPhase1_definitivo/UntilPhase1_definitivo.csv"
      ]
    },
    {
      "name": "Ticket Sales Distributions",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Code/ticket_sales_distribution_plots.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--inputs",
        "${workspaceFolder}/Documenti/Tickets/Lista_ticket_7chakras_2019_onlyGood/Lista_ticket_7chakras_2019_onlyGood_VERIFIED_FLAT.csv",
        "${workspaceFolder}/Documenti/Tickets/Lista_ticket_7chakras_2025_onlyGood/Lista_ticket_7chakras_2025_onlyGood_VERIFIED_FLAT.csv",
        "${workspaceFolder}/Documenti/Tickets/UntilPhase1_definitivo/UntilPhase1_2026_definitivo_FLAT.csv",
        "--output-dir",
        "${workspaceFolder}/Documenti/Reports/vendite_distribuzione_finePhase1_updateWPicks_1",
        "--peak-analysis",
        "--peak-quantiles",
        "[0.9, 0.8, 0.7]"
      ]
    },
    {
      "name": "Filter tickets by type (CSV -> subset)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/filter_tickets.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--input", "C:\\Users\\spina\\Documents\\Other_Codes\\7chackras\\Documenti\\Tickets\\UntilPhase1_2026_definitivo_FLAT_Phase0Only.csv",
        "--ticket_keyword", "phase 0"
      ]
    }
  ]
}
